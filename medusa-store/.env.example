# .env.example
# Copy this file to .env.local (or .env) and fill in your real values.

# Backend URL your front-end will talk to
VITE_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Storefront publishable key (pk_)
VITE_MEDUSA_PUBLISHABLE_KEY=pk_your_storefront_key_here

# Stripe publishable key (pk_test_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_pk_here

# Stripe secret key (sk_test_)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_here

# CORS origins (where your front-end runs)
STORE_CORS=http://localhost:5173
ADMIN_CORS=http://localhost:5173
AUTH_CORS=http://localhost:5173

# Database (Postgres) URL
DATABASE_URL=postgres://user:password@localhost/medusa_store

# Any other secrets…
JWT_SECRET=your_jwt_secret
COOKIE_SECRET=your_cookie_secret
